        "donatingCentered": true,
        "densityFaceStag": true,
        "finalCheck": true,
        "rho1" : 1.0,
        "rho2" : 0.001,
        "gmol1" : 6.666667E-3,
        "gmol2" : 6.666667E-5,
        "gravity" : [0.0, -1024.0, 0.0]
    },

    "snapshots": {
        "itsamp": 5,
        "tstart": 0.0,
        "fields": ["UXZWAL", "VXZSUR", "ETAXZ", "UXYMID", "CXYMID", "UYZMID", "VYZMID", "WYZMID", "CYZMID", "UPROF"]

{
    "time": {
        "dt": 8.667E-4,
        "mtstep": 25000,
        "itinfo": 25,
        "itcheck": 2500,
        "read": false
    },
    "io": {
        "grids": "grids.h5",
        "infile": "fields.h5",
        "outfile": "fields.h5"
    },
    "ib": {
        "type": "noib"
    },
    "flow": {
        "gmol": 0.001,
        "rho": 1.0,
        "uinf": [0.0, 0.0, 0.0],
        "gradp": [-1.0, 0.0, 0.0],
        "pressuresolver": {
            "type": "sip",
            "epcorr": 1.0E-6,
            "nouter": 500,
            "ninner": 10,
            "loglevel": 2
        },
        "lesmodel": {
            "model": "none"
        }
    },

    "multiphase": {
        "test": "Open Channel Flow",
        "skipAdvection": false,
        "skipDiffusion": false,
        "skipPressure": false,
        "skipExternal": false,
        "vofTolerance": 1.0E-12,
        "volTolerance": 1.0E-8,
        "advectionScheme": "QUICK",
        "donatingCentered": true,
        "momentumBalance": false,
        "finalCheck": true,
        "rho1" : 1.0,
        "rho2" : 0.001,
        "gmol1" : 6.666667E-3,
        "gmol2" : 6.666667E-5,
        "gravity" : [0.0, -1024.0, 0.0]
    },

    "snapshots": {
        "itsamp": 5000,
        "tstart": 0.0,
        "fields": ["U", "V", "W", "P", "C", "NORMX", "NORMY", "NORMZ", "ALPHA"]
    },

    "probes": {
        "itsamp": 1,
        "tstart": 0.0,
        "arrays": [
            {
                "name": "centerprobe",
                "variables": ["U", "V", "W", "P", "C"],
                "positions": [
                    [ 0.5, 0.5, 0.5 ]
                ]
            }
        ]
    }

}

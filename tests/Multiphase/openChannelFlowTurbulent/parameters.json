{
    "time": {
        "dt": 6.0E-4,
        "mtstep": 20,
        "itinfo": 1,
        "itcheck": 1000,
        "read": false
    },
    "io": {
        "grids": "grids.h5",
        "infile": "fields.h5",
        "outfile": "fields.h5"
    },
    "ib": {
        "type": "noib"
    },
    "flow": {
        "gmol": 0.001,
        "rho": 1.0,
        "uinf": [0.0, 0.0, 0.0],
        "gradp": [-1.0, 0.0, 0.0],
